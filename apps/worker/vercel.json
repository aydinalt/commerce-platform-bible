{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace @commerce/worker",
  "crons": [
    {
      "path": "/api/feeds",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/outbox",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "0 2 * * *"
    }
  ],
  "framework": null,
  "installCommand": "npm ci"
}
