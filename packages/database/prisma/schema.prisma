generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

/// `US-IDN-F06-001` AC-1 fixes the V1 vocabulary at exactly these two values.
/// A registration awaiting email-control proof is not an account at all, so it
/// has no status here — see `PendingRegistration`.
enum AccountStatus {
  ENABLED
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

/// The Business-side input to public exposure (`US-BUS-F01-001` AC-5). Distinct
/// from moderation: `US-BUS-F02-001` AC-7 reads both before any public identity
/// is shown.
enum BusinessExposureInput {
  ELIGIBLE
  INELIGIBLE
}

enum BusinessModerationStatus {
  UNRESTRICTED
  RESTRICTED
}

/// A General Moderation Case is Open until PRD-0006 explicitly closes it
/// (`US-BUS-F07-001` AC-12, AC-15). An owner response never moves it.
enum ModerationCaseStatus {
  OPEN
  CLOSED
}

/// What a General Moderation case is about (`US-PLT-F02-001`).
enum ModerationTargetType {
  OFFERING
  BUSINESS
  USER_ACCOUNT
}

/// The exact seven General Moderation actions of PRD-0006 §7 and Owner
/// Decision D15/D16. Affiliate Destination Review, Validate, Enable and
/// Disable are absent: they are a separate action family (AC-10).
enum ModerationAction {
  REQUEST_CORRECTION
  HIDE_OFFERING
  RESTORE_OFFERING
  RESTRICT_BUSINESS
  RESTORE_BUSINESS
  SUSPEND_USER
  REINSTATE_USER
}

/// The four Business-owned Request Correction targets of PRD-0005 §12.1.
/// `USER_ACCOUNT` is absent, which is AC-2: User Account correction is outside
/// V1, so it is not a value a notice can take.
enum CorrectionTarget {
  BUSINESS_INFORMATION
  OFFERING_CONTENT
  AFFILIATE_DESTINATION_CONFIGURATION
  DIRECT_CONTACT_INFORMATION
}

/// The parts of Offering content a correction may aim at. Category is absent:
/// a correction fixes what an Offering says, it does not move the Offering to
/// another part of the catalogue while its Business is Restricted.
enum OfferingContentArea {
  TITLE
  SUMMARY
  ATTRIBUTES
}

/// The four Offering lifecycle states of PRD-0001 §6. `Hidden` is an Admin
/// removal from circulation that keeps its publication history; `Archived` is
/// the terminal result of owner retirement.
enum OfferingStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

/// The five V1 Attribute value kinds (`US-PLT-F09-001` AC-2). `Number` covers
/// what were separate integer and decimal kinds; the two Select kinds differ
/// only in how many allowed values one Offering may hold.
enum AttributeValueKind {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
}

/// PRD-0001 v4.0 §5.10.1. Three answers, and they are three because two of
/// them are already confused everywhere else.
///
/// `ON_REQUEST` is a property of the **Offering**: a consultancy, a repair, a
/// bespoke installation genuinely has no amount until the work is specified,
/// and the amount is settled after the Handoff. `UNKNOWN` is a property of the
/// **platform's knowledge**: a feed carried no amount, or none has been read
/// yet.
///
/// Showing a service Offering as "price unknown" tells a person the platform
/// has failed when nothing has failed. This is the same distinction PRD-0002
/// §14 draws between zero results and results unavailable.
enum PricingKind {
  FIXED
  ON_REQUEST
  UNKNOWN
}

/// PRD-0001 v4.0 §5.10.3. Stock is a third state rather than a boolean,
/// because "we do not know" is an answer a feed gives constantly and a
/// two-valued column would have to lie about it.
enum StockState {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

/// PRD-0001 v4.0 §5.11. How the record came to exist, and nothing more.
///
/// §5.11.2 is explicit that this confers no authority: a `FEED` Offering is
/// moderated exactly as a `BUSINESS` one is. What it does govern is §5.11.1 —
/// an automated intake may modify only what it created, because an intake that
/// overwrites a typed correction destroys a decision and leaves no trace.
enum OfferingSource {
  MANUAL
  FEED
  BUSINESS
}

/// PRD-0001 §9.3. `Enabled` and `Disabled` are reached only through the
/// Platform administration actions PRD-0006 owns; a Business owner's authoring
/// always lands on `DRAFT`.
enum AffiliateDestinationStatus {
  DRAFT
  ENABLED
  DISABLED
}

/// PRD-0001 §9.4. `NOT_VALIDATED` means the *current* configuration has no
/// current result — which is why changing the configuration returns to it.
enum AffiliateValidationResult {
  NOT_VALIDATED
  VALID
  INVALID
}

enum HandoffEligibility {
  ELIGIBLE
  INELIGIBLE
}

/// The complete V1 Direct Contact channel set (`US-DEC-F06-001` AC-4,
/// PRD-0004). An enum rather than a string: a fourth channel is not a value
/// this can hold.
enum DirectContactChannel {
  TELEPHONE
  EMAIL
  URL
}

enum PublicationStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  WITHDRAWN
}

model UserAccount {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String          @unique @db.VarChar(320)
  /// The name the registration form has always asked for and the platform used
  /// to discard (I62). Nullable because every account predating the column has
  /// none, and inventing one would be worse than admitting it. Presented as
  /// "Aylin K." rather than in full — masking is a presentation rule, so what
  /// is stored is what the person typed.
  displayName     String?         @map("display_name") @db.VarChar(80)
  emailVerifiedAt DateTime        @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus   @default(ENABLED)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessOwners  BusinessOwner[]
  credential      UserCredential?
  sessions        UserSession[]
  passwordReset   PasswordReset?
  adminAuthorization AdminAuthorization?
  affiliateReviews   AffiliateDestinationReview[] @relation("AffiliateReviewer")
  affiliateValidations AffiliateDestination[]     @relation("AffiliateValidator")
  directContactReveals DirectContactReveal[]
  openedCases          ModerationCase[]           @relation("CaseOpener")
  auditEvents          AdminAuditEvent[]
  closedCases          ModerationCase[]           @relation("CaseCloser")
  moderationCases      ModerationCase[]           @relation("CaseSubject")
  moderationResolutions ModerationResolution[]    @relation("ResolutionRecorder")
  correctionReviews     CorrectionReview[]        @relation("CorrectionReviewer")
  correctionRequests   CorrectionRequest[]        @relation("CorrectionRequester")
  correctionEdits      CorrectionEdit[]           @relation("CorrectionEditor")
  productReviews       ProductReview[]
  favourites           Favourite[]
  /// I69. Reports this person made, and reports they reviewed as an Admin.
  listingReports       ListingReport[]            @relation("ListingReportReporter")
  listingReportReviews ListingReport[]            @relation("ListingReportReviewer")
  /// I75. Who last changed the advertising settings, and who marked a Category
  /// ad-free.
  advertisingSettings  AdvertisingSetting[]       @relation("AdvertisingSettingEditor")
  advertisingExclusions AdvertisingCategoryExclusion[] @relation("AdvertisingExclusionEditor")
  /// I76. Feeds this Admin configured.
  offeringFeeds        OfferingFeed[]             @relation("OfferingFeedAuthor")

  @@map("user_account")
}

/// Admin authorization attached to an existing account (`US-IDN-F08-001` AC-1).
/// Granted and removed only by controlled operational provisioning, never
/// through the product API (AC-3, AC-4).
model AdminAuthorization {
  userId    String      @id @map("user_id") @db.Uuid
  grantedBy String      @map("granted_by") @db.VarChar(160)
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_authorization")
}

/// A recovery in progress. Like a pending registration, it holds no usable
/// token until the worker dispatches its message.
model PasswordReset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  tokenHash    String?   @unique @map("token_hash") @db.Char(64)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset")
}

/// Credentials are isolated from the account so they can be rotated, audited or
/// replaced by an external provider without touching the product-owned User
/// model (ADR-0012 §7).
model UserCredential {
  userId       String      @id @map("user_id") @db.Uuid
  passwordHash String      @map("password_hash")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

/// A registration that has not yet proven control of its email address.
/// `US-IDN-F02-001` AC-7 forbids representing this as an account state, so it is
/// deliberately a separate record that becomes a `UserAccount` only on proof.
model PendingRegistration {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  /// Carried from the form to the account the confirmation creates, so the name
  /// survives the round trip through the email link (I62).
  displayName  String?   @map("display_name") @db.VarChar(80)
  /// Absent until the message is dispatched. The token is minted at delivery so
  /// that no replayable secret is ever written to the database.
  tokenHash    String?   @unique @map("token_hash") @db.Char(64)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("pending_registration")
}

/// The browser holds a high-entropy opaque identifier; only its digest is
/// stored, so a database disclosure cannot be replayed as a live session
/// (ADR-0012 §2).
model UserSession {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  tokenHash          String      @unique @map("token_hash") @db.Char(64)
  /// Explicitly chosen, never inferred (`US-IDN-F07-001` AC-3). Null means the
  /// person is in the authenticated User baseline, not in any Business.
  selectedBusinessId String?     @map("selected_business_id") @db.Uuid
  /// Entered explicitly and re-evaluated per request (`US-IDN-F08-001` AC-11).
  adminContext       Boolean     @default(false) @map("admin_context")
  issuedAt           DateTime    @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt         DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?   @map("revoked_at") @db.Timestamptz(6)
  user               UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedBusiness   Business?   @relation(fields: [selectedBusinessId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([selectedBusinessId])
  @@map("user_session")
}

/// Throttling state for authentication attempts. Keyed by a digest so the
/// subject (an email address or client address) is never stored in clear text.
model AuthThrottle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String   @db.VarChar(40)
  subjectHash String   @map("subject_hash") @db.Char(64)
  attempts    Int      @default(0)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@unique([scope, subjectHash])
  @@index([firstSeenAt])
  @@map("auth_throttle")
}

model Business {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String          @unique @db.VarChar(120)
  name      String          @db.VarChar(200)
  status    BusinessStatus  @default(DRAFT)
  publicExposure BusinessExposureInput @default(ELIGIBLE) @map("public_exposure")
  /// Public Business identity set — display name plus these two only
  /// (`US-BUS-F02-001` AC-6).
  logoUrl          String? @map("logo_url") @db.VarChar(2048)
  shortDescription String? @map("short_description") @db.VarChar(500)
  /// Protected Direct Contact channels. Never public (AC-9); released only
  /// through PRD-0004 to an Enabled authenticated User (AC-10).
  contactTelephone String? @map("contact_telephone") @db.VarChar(40)
  contactEmail     String? @map("contact_email") @db.VarChar(320)
  contactUrl       String? @map("contact_url") @db.VarChar(2048)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owners    BusinessOwner[]
  offerings Offering[]
  moderationState BusinessModerationState?
  selectedInSessions UserSession[]
  moderationCases ModerationCase[]
  /// I76. The partner catalogues whose Offerings this Business owns.
  offeringFeeds   OfferingFeed[]

  @@map("business")
}

model BusinessModerationState {
  businessId String                   @id @map("business_id") @db.Uuid
  status     BusinessModerationStatus @default(UNRESTRICTED)
  reasonCode String?                  @map("reason_code") @db.VarChar(100)
  updatedAt  DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_moderation_state")
}

/// A General Moderation Case (PRD-0006 §7.3). Business responds to it; only
/// Platform opens, re-reviews and closes it.
model ModerationCase {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType ModerationTargetType @map("target_type")
  /// Exactly one target, and the Business a case concerns present wherever
  /// there is one to name — an Offering case carries both.
  offeringId String?              @map("offering_id") @db.Uuid
  businessId String?              @map("business_id") @db.Uuid
  userId     String?              @map("user_id") @db.Uuid
  status     ModerationCaseStatus @default(OPEN)
  openedBy   String               @map("opened_by") @db.Uuid
  openedAt   DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedBy   String?              @map("closed_by") @db.Uuid
  closedAt   DateTime?            @map("closed_at") @db.Timestamptz(6)
  offering   Offering?            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       UserAccount?         @relation("CaseSubject", fields: [userId], references: [id], onDelete: Restrict)
  opener     UserAccount          @relation("CaseOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  closer     UserAccount?         @relation("CaseCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  corrections CorrectionRequest[]
  resolutions ModerationResolution[]
  reviews     CorrectionReview[]

  @@unique([id, businessId], map: "moderation_case_id_business_id_key")
  @@index([businessId, status])
  @@index([targetType, status])
  @@map("moderation_case")
}

/// One recorded re-review of an owner's correction response
/// (`US-PLT-F06-001` AC-10). Closure needs one dated after the most recent
/// owner edit — an earlier review cannot stand in for a later response.
model CorrectionReview {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  note           String?        @db.VarChar(1000)
  reviewedBy     String         @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer       UserAccount    @relation("CorrectionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([caseId, reviewedAt])
  @@map("correction_review")
}

/// One applied action or one recorded no-action decision. Closure reads these
/// rather than a flag, because a flag can be set by something that did not do
/// the work (`US-PLT-F02-001` AC-7).
model ModerationResolution {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String            @map("case_id") @db.Uuid
  action         ModerationAction?
  noActionReason String?           @map("no_action_reason") @db.VarChar(1000)
  recordedBy     String            @map("recorded_by") @db.Uuid
  recordedAt     DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  moderationCase ModerationCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recorder       UserAccount       @relation("ResolutionRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([caseId, recordedAt])
  @@map("moderation_resolution")
}

/// One recorded Request Correction. The Offering and content area are present
/// exactly when the target is Offering content, which a CHECK enforces in both
/// directions.
model CorrectionRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String               @map("case_id") @db.Uuid
  businessId  String               @map("business_id") @db.Uuid
  target      CorrectionTarget
  offeringId  String?              @map("offering_id") @db.Uuid
  contentArea OfferingContentArea? @map("content_area")
  note        String?              @db.VarChar(1000)
  requestedBy String               @map("requested_by") @db.Uuid
  requestedAt DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  moderationCase ModerationCase    @relation(fields: [caseId, businessId], references: [id, businessId], onDelete: Cascade, map: "correction_request_case_fkey")
  offering    Offering?            @relation(fields: [offeringId, businessId], references: [id, businessId], onDelete: Restrict, map: "correction_request_offering_fkey")
  requester   UserAccount          @relation("CorrectionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  edits       CorrectionEdit[]

  @@index([businessId, requestedAt])
  @@index([caseId])
  @@map("correction_request")
}

/// One saved owner response. Its existence is what makes Platform re-review
/// outstanding (`US-BUS-F07-001` AC-14) — no separate flag to forget.
model CorrectionEdit {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionRequestId String              @map("correction_request_id") @db.Uuid
  offeringId          String              @map("offering_id") @db.Uuid
  contentArea         OfferingContentArea @map("content_area")
  editedBy            String              @map("edited_by") @db.Uuid
  editedAt            DateTime            @default(now()) @map("edited_at") @db.Timestamptz(6)
  request             CorrectionRequest   @relation(fields: [correctionRequestId], references: [id], onDelete: Cascade)
  offering            Offering            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  editor              UserAccount         @relation("CorrectionEditor", fields: [editedBy], references: [id], onDelete: Restrict)

  @@index([correctionRequestId])
  @@map("correction_edit")
}

model BusinessOwner {
  businessId String      @map("business_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([businessId, userId])
  /// Exactly one owner per Business in V1 (`US-BUS-F01-001` AC-8, AC-10).
  @@unique([businessId])
  @@index([userId])
  @@map("business_owner")
}

model Domain {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stableKey  String     @unique @map("stable_key") @db.VarChar(80)
  slug       String     @unique @db.VarChar(120)
  name       String     @db.VarChar(160)
  active     Boolean    @default(true)
  categories Category[]
  discoveryStarts DiscoveryStart[]
  presentationOpens OfferingPresentationOpen[]
  compareStarts CompareStart[]

  @@map("domain")
}

enum DiscoveryPathKind {
  BROWSE
  SEARCH
}

/// A bounded occurrence: a person began looking (PRD-0002 §5.10). One per path,
/// so a descendant Category selection inside the same Browse path adds none
/// (`US-DSC-F03-001` AC-8). PRD-0006 Basic Analytics is its only consumer.
model DiscoveryStart {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pathId    String            @unique @map("path_id") @db.Uuid
  kind      DiscoveryPathKind
  /// Inherited from the selected Category for a Browse Start (AC-2).
  domainId  String?           @map("domain_id") @db.Uuid
  startedAt DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  domain    Domain?           @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([kind, startedAt])
  @@map("discovery_start")
}

/// One occurrence of complete public Presentation successfully beginning for
/// one eligible Offering (PRD-0001 §8.2.1). A management view produces none.
model OfferingPresentationOpen {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  /// Denormalised: the occurrence belongs to the Domain it happened in, even
  /// if the Offering is recategorised afterwards.
  domainId   String   @map("domain_id") @db.Uuid
  openedAt   DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([offeringId, openedAt])
  @@index([domainId, openedAt])
  @@map("offering_presentation_open")
}

/// Current-flow Compare state (`US-DEC-F01-001`). Not history and not a
/// session: it expires, and PRD-0003 gives V1 no saved Compare history.
model ComparisonSet {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The shared active leaf Category every member must belong to (AC-3).
  categoryId String                @map("category_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(6)
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  members    ComparisonSetMember[]
  decisionFlows DecisionFlow[]

  @@index([expiresAt])
  @@map("comparison_set")
}

/// Membership. Eligibility, the shared leaf and the ceiling of five are
/// enforced by a trigger, which Prisma cannot model — the integration suites
/// are what prove they are there.
model ComparisonSetMember {
  comparisonSetId String        @map("comparison_set_id") @db.Uuid
  offeringId      String        @map("offering_id") @db.Uuid
  addedAt         DateTime      @default(now()) @map("added_at") @db.Timestamptz(6)
  comparisonSet   ComparisonSet @relation(fields: [comparisonSetId], references: [id], onDelete: Cascade)
  offering        Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([comparisonSetId, offeringId])
  @@index([offeringId])
  @@map("comparison_set_member")
}

/// The current Decision flow (`US-DEC-F02-001`). Its context is exactly one
/// eligible Offering or one Comparison Set — a database CHECK, because a
/// context holding two things would let Chat speak about something the person
/// never chose. It carries no person and expires on its own, which is how AC-6
/// forbids a personal Decision history by construction.
model DecisionFlow {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId      String?        @map("offering_id") @db.Uuid
  comparisonSetId String?        @map("comparison_set_id") @db.Uuid
  /// The one Offering this flow is about to act on (`US-DEC-F04-001`). Null is
  /// the normal starting state: every handoff waits for an explicit act. A
  /// trigger restricts it to the context, and clears it when the selected
  /// member leaves a Comparison Set.
  selectedOfferingId String?     @map("selected_offering_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  offering        Offering?      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  comparisonSet   ComparisonSet? @relation(fields: [comparisonSetId], references: [id], onDelete: Cascade)
  selectedOffering Offering?     @relation("DecisionSelection", fields: [selectedOfferingId], references: [id], onDelete: Restrict)
  turns           DecisionChatTurn[]

  @@index([expiresAt])
  @@map("decision_flow")
}

/// One question and its reply, for the current flow only (`US-DEC-F03-001`
/// AC-9). Removed with the flow, and carrying no person.
model DecisionChatTurn {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String       @map("decision_flow_id") @db.Uuid
  position       Int
  question       String
  reply          String
  askedAt        DateTime     @default(now()) @map("asked_at") @db.Timestamptz(6)
  decisionFlow   DecisionFlow @relation(fields: [decisionFlowId], references: [id], onDelete: Cascade)

  /// The migration names this constraint for what it means rather than by
  /// Prisma's default, so the datamodel says which name it expects. Without the
  /// map the drift gate sees a rename on every run.
  @@unique([decisionFlowId, position], map: "decision_chat_turn_unique_position")
  @@map("decision_chat_turn")
}

/// One successful Affiliate Handoff initiation (`US-DEC-F05-001` AC-8), which
/// `US-DEC-F07-001` consumes as Affiliate Handoff Completion. It records that
/// an external destination was made active and nothing about what happened
/// there. The flow reference is not a foreign key on purpose: the flow expires
/// and the initiation must outlive it.
model AffiliateHandoff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String   @map("decision_flow_id") @db.Uuid
  offeringId     String   @map("offering_id") @db.Uuid
  /// The exact address made active, as it stood at that moment.
  destination    String   @db.VarChar(2048)
  initiatedAt    DateTime @default(now()) @map("initiated_at") @db.Timestamptz(6)
  offering       Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@index([offeringId, initiatedAt])
  @@index([decisionFlowId])
  @@map("affiliate_handoff")
}

/// One successful Direct Contact reveal (`US-DEC-F06-001` AC-10), which
/// `US-DEC-F07-001` consumes as Direct Contact Completion. It records which
/// channel was revealed and to whom, and nothing about what followed — there is
/// no message, inbox, conversation or reply here, and the revealed value itself
/// is absent because a log of it would be a second place it could leak from.
model DirectContactReveal {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String               @map("decision_flow_id") @db.Uuid
  offeringId     String               @map("offering_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  channel        DirectContactChannel
  revealedAt     DateTime             @default(now()) @map("revealed_at") @db.Timestamptz(6)
  offering       Offering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  user           UserAccount          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([offeringId, revealedAt])
  @@index([decisionFlowId])
  @@map("direct_contact_reveal")
}

/// One occurrence of assistive Chat beginning on a valid Decision Context
/// (AC-3). One per flow, and it outlives the flow: that Chat began is a fact
/// about the past, not current-flow state.
model DecisionChatStart {
  decisionFlowId String   @id @map("decision_flow_id") @db.Uuid
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("decision_chat_start")
}

/// One occurrence of a valid Comparison Set being opened in Compare (AC-11).
/// One per set, so reopening the same comparison is not counted twice.
model CompareStart {
  comparisonSetId String   @id @map("comparison_set_id") @db.Uuid
  domainId        String   @map("domain_id") @db.Uuid
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([domainId, startedAt])
  @@map("compare_start")
}

model Category {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId   String              @map("domain_id") @db.Uuid
  parentId   String?             @map("parent_id") @db.Uuid
  stableKey  String              @unique @map("stable_key") @db.VarChar(100)
  slug       String              @db.VarChar(120)
  name       String              @db.VarChar(160)
  active     Boolean             @default(true)
  domain     Domain              @relation(fields: [domainId], references: [id], onDelete: Restrict)
  /// The parent reference carries the Domain as well as the identifier, so a
  /// child can only point at a parent that already agrees with it
  /// (`US-PLT-F08-001` AC-7, AC-10). Cross-Domain parenting is a foreign key
  /// violation rather than a rule someone has to remember to check.
  parent     Category?           @relation("CategoryTree", fields: [parentId, domainId], references: [id, domainId], onDelete: Restrict, onUpdate: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  offerings  Offering[]
  comparisonSets ComparisonSet[]
  /// I70. The complementary products listings under this heading suggest.
  complementaryPlacements ComplementaryPlacement[]
  /// I75. Marked ad-free, where somebody has marked it.
  advertisingExclusion    AdvertisingCategoryExclusion?
  /// I76. Feeds whose Offerings are filed under this Category.
  offeringFeeds           OfferingFeed[]

  @@unique([id, domainId])
  /// I99. Globally unique, because `UX-0002` **Frozen v1.4** §8A makes the slug
  /// an address: `/kategori/{slug}` must identify one Category and §8A.5 calls
  /// it the canonical one. Retired Categories take part, so a shared address
  /// never starts answering about a different Category.
  @@unique([slug], map: "category_slug_key")
  /// Kept though the one above implies it: `pg-catalog.repository.ts` names
  /// this constraint when it turns a unique violation into the Admin's message.
  @@unique([domainId, slug])
  @@index([parentId])
  @@map("category")
}

model AttributeDefinition {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stableKey  String                   @unique @map("stable_key") @db.VarChar(100)
  name       String                   @db.VarChar(160)
  valueKind  AttributeValueKind       @map("value_kind")
  /// A governed label, and only for `NUMBER` (AC-3).
  unit       String?                  @db.VarChar(40)
  searchable Boolean                  @default(false)
  filterable Boolean                  @default(false)
  comparable Boolean                  @default(false)
  /// Owned by the definition rather than by each applicability link: AC-7
  /// evaluates it across every applicable Category at once.
  requiredForPublication Boolean      @default(false) @map("required_for_publication")
  active     Boolean                  @default(true)
  options    AttributeOption[]
  categories CategoryAttribute[]
  values     OfferingAttributeValue[]

  @@map("attribute_definition")
}

model AttributeOption {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeDefinitionId String                   @map("attribute_definition_id") @db.Uuid
  stableKey             String                   @map("stable_key") @db.VarChar(100)
  label                 String                   @db.VarChar(160)
  sortOrder             Int                      @default(0) @map("sort_order")
  active                Boolean                  @default(true)
  attributeDefinition   AttributeDefinition      @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  offeringValues        OfferingAttributeValue[]

  @@unique([attributeDefinitionId, stableKey])
  @@map("attribute_option")
}

model CategoryAttribute {
  categoryId            String              @map("category_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  sortOrder             Int                 @default(0) @map("sort_order")
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeDefinitionId])
  @@map("category_attribute")
}

model Offering {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String                    @map("business_id") @db.Uuid
  categoryId   String                    @map("category_id") @db.Uuid
  slug         String                    @db.VarChar(160)

  /// I67. The number a person reads, says and types — `İLN-482007` on the
  /// surface, `482007` here. Assigned once by the sequence and never
  /// reassigned: the promise it makes is that a number written down yesterday
  /// finds the same listing today.
  ///
  /// `BigInt` rather than `Int` because the sequence is never reset and a
  /// catalogue outliving two billion listings should not have to migrate its
  /// own identifiers.
  listingNumber BigInt                   @unique @default(autoincrement()) @map("listing_number")

  title        String                    @db.VarChar(240)
  summary      String?                   @db.VarChar(1000)
  status       OfferingStatus            @default(DRAFT)
  version      Int                       @default(1)

  /// PRD-0001 v4.0 §5.10. The Kind is the fact; the amount is a detail of one
  /// of the three Kinds. `UNKNOWN` is the default because that is what is true
  /// of an Offering nobody has priced yet.
  pricingKind  PricingKind               @default(UNKNOWN) @map("pricing_kind")
  /// Minor-unit precision without float arithmetic. `NUMERIC(12,2)` holds a
  /// price to ten billion lira; money in a `double` is a rounding error waiting
  /// for a large enough catalogue.
  amount       Decimal?                  @db.Decimal(12, 2)
  /// ISO 4217. Fixed width so a three-letter code cannot be stored as four.
  currency     String?                   @db.Char(3)
  /// §5.10.3: **a price without an instant is not a price.** A surface showing
  /// an amount must be able to say when it was true.
  amountSetAt  DateTime?                 @map("amount_set_at") @db.Timestamptz(6)
  /// The prior amount, so a reduction can be shown. §5.10.4 forbids storing the
  /// percentage: a stored percentage is a second copy of a fact that can
  /// disagree with the two amounts it came from.
  priorAmount  Decimal?                  @map("prior_amount") @db.Decimal(12, 2)
  /// Separable delivery charge. `0` is free delivery and `null` is "not
  /// stated"; §5.10.5 orders on amount **plus** this, because ordering on the
  /// sticker price while delivery differs makes the ordering wrong.
  deliveryCost Decimal?                  @map("delivery_cost") @db.Decimal(12, 2)
  stockState   StockState                @default(UNKNOWN) @map("stock_state")

  /// PRD-0001 v4.0 §5.11. Provenance, and §5.11.2 is explicit that it confers
  /// no authority.
  source       OfferingSource            @default(BUSINESS)

  /// PRD-0001 v4.1 §7.2, third final-eligibility input (I78). False when an
  /// automated intake has recorded that its source no longer offers this
  /// Offering — the Owner's 72-hour rule. Reversible by that same intake and
  /// **not** a lifecycle change: `Archived` has no way back and `Hidden` is an
  /// Admin's moderation outcome, so neither could carry it.
  intakeAvailable Boolean                 @default(true) @map("intake_available")

  /// PRD-0001 v4.0 §5.12. A matching hint, not an identity: Offerings sharing
  /// one may be presented together, and §5.12.3 forbids grouping on anything
  /// else. Most Offerings in most Domains will never carry one.
  productKey   String?                   @map("product_key") @db.VarChar(64)

  publishedAt  DateTime?                 @map("published_at") @db.Timestamptz(6)
  archivedAt   DateTime?                 @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category     Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes   OfferingAttributeValue[]
  visuals      OfferingVisual[]
  publications OfferingPublication[]
  projection   OfferingSearchProjection?
  /// Zero or one, never shared (PRD-0001 §9.1).
  affiliateDestination AffiliateDestination?
  presentationOpens    OfferingPresentationOpen[]
  comparisonMemberships ComparisonSetMember[]
  decisionFlows         DecisionFlow[]
  decisionSelections    DecisionFlow[] @relation("DecisionSelection")
  affiliateHandoffs     AffiliateHandoff[]
  directContactReveals  DirectContactReveal[]
  correctionRequests    CorrectionRequest[]
  correctionEdits       CorrectionEdit[]
  moderationCases       ModerationCase[]
  /// I62 and I64. Both are keyed on the product group rather than on this row;
  /// these back-references exist because the rows name an Offering as
  /// provenance, not because a review or a favourite belongs to one listing.
  reviews               ProductReview[]
  favourites            Favourite[]
  /// I69. Reports readers made about this listing.
  listingReports        ListingReport[]
  /// I76. Present only on an Offering an intake created, which is what makes
  /// PRD-0001 §5.11.1 true by construction: an intake reaches an Offering
  /// through this row, so it can never reach one it did not create.
  feedItem              OfferingFeedItem?

  @@unique([businessId, slug])
  @@unique([id, businessId], map: "offering_id_business_id_key")
  @@index([categoryId, status])

  /// PRD-0001 v4.0 §5.11.1. Declared here as well as created in the migration,
  /// because `db:drift` compares the migrated database to this file and an
  /// index present in one and not the other is drift — which is what took CI
  /// red on #149 and #150.
  ///
  /// **The other three indexes on this table are deliberately absent, and must
  /// stay absent.** `offering_price_order_idx`, `offering_product_key_idx` and
  /// `offering_published_active_idx` are all partial — and the price one is an
  /// expression index besides. Prisma has no `where` argument on `@@index` and
  /// cannot express either, so it neither reads them from the database nor
  /// asks about them; `offering_published_active_idx` has been undeclared
  /// since it was written and has never drifted, which is the evidence rather
  /// than the assumption. Adding a plain `@@index([productKey])` here to
  /// "match" the migration would create the drift it appears to fix: the
  /// database's index is partial and this one would not be.
  /// The name is written out rather than left to Prisma's default. The default
  /// would be `offering_source_idx` and would be correct — but "would be" is a
  /// guess, and a guess about an index name is a guess about whether the next
  /// drift check sees a match or a rename. Stating it costs one argument.
  @@index([source], map: "offering_source_idx")
  @@map("offering")
}

/// One value an Offering holds for one Attribute definition. A `MULTI_SELECT`
/// definition is several of these rows; every other kind is exactly one
/// (`US-OFR-F02-001`).
model OfferingAttributeValue {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId            String              @map("offering_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  textValue             String?             @map("text_value")
  numberValue           Decimal?            @map("number_value") @db.Decimal(24, 8)
  booleanValue          Boolean?            @map("boolean_value")
  optionId              String?             @map("option_id") @db.Uuid
  offering              Offering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option                AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([attributeDefinitionId])
  @@map("offering_attribute_value")
}

/// A visual supplied for one Offering (`US-OFR-F05-001` AC-4, `US-DSC-F06-001`
/// AC-4, UX-0003 §8.2).
///
/// **An address, not bytes.** `Business.logoUrl` has held an image this way
/// since I1, so this follows the platform's existing answer rather than
/// introducing a second one — and object storage would need a hosting target,
/// which does not exist yet.
///
/// `position` is the order the set is inspected in and `0` is the primary
/// visual, so "which one goes on the Listing Card" is a fact about the data
/// rather than a rule some reader has to know. The unique constraint makes two
/// primaries unrepresentable.
model OfferingVisual {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  position   Int
  url        String   @db.VarChar(2048)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, position])
  @@map("offering_visual")
}

/// A distinct object associated with exactly one Offering, not a field on it
/// (`US-OFR-F06-001`, PRD-0001 §9.1).
model AffiliateDestination {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId        String                     @unique @map("offering_id") @db.Uuid
  reference         String                     @db.VarChar(2048)
  status            AffiliateDestinationStatus @default(DRAFT)
  validationResult  AffiliateValidationResult  @default(NOT_VALIDATED) @map("validation_result")
  /// Why the current result was reached. PRD-0001 §9.4 defines what `Valid`
  /// and `Invalid` mean and leaves the method open, so this records an outcome
  /// rather than a mechanism.
  validationReason  String?                    @map("validation_reason") @db.VarChar(1000)
  validatedAt       DateTime?                  @map("validated_at") @db.Timestamptz(6)
  validatedBy       String?                    @map("validated_by") @db.Uuid
  handoffEligibility HandoffEligibility        @default(INELIGIBLE) @map("handoff_eligibility")
  version           Int                        @default(1)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  offering          Offering                   @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  validator         UserAccount?               @relation("AffiliateValidator", fields: [validatedBy], references: [id], onDelete: Restrict)
  reviews           AffiliateDestinationReview[]

  @@map("affiliate_destination")
}

/// Evidence that an approved Admin review happened. `US-OFR-F07-001` AC-2
/// makes Review change no result, and PRD-0001 §9.4 makes it a condition a
/// `Valid` result depends on — so it has to be recorded somewhere.
model AffiliateDestinationReview {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId String               @map("destination_id") @db.Uuid
  reviewedBy    String               @map("reviewed_by") @db.Uuid
  note          String?              @db.VarChar(1000)
  reviewedAt    DateTime             @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  destination   AffiliateDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  reviewer      UserAccount          @relation("AffiliateReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([destinationId, reviewedAt])
  @@map("affiliate_destination_review")
}

model OfferingPublication {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId         String            @map("offering_id") @db.Uuid
  status             PublicationStatus @default(PENDING)
  eligibilityVersion Int               @map("eligibility_version")
  reasonCode         String?           @map("reason_code") @db.VarChar(100)
  evaluatedAt        DateTime          @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  offering           Offering          @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([offeringId, eligibilityVersion])
  @@index([status, evaluatedAt])
  @@map("offering_publication")
}

model OfferingSearchProjection {
  offeringId         String   @id @map("offering_id") @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  domainId           String   @map("domain_id") @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  title              String   @db.VarChar(240)
  summary            String?
  businessName       String   @map("business_name") @db.VarChar(200)
  /// The active Category path display names, so a person can recognise an
  /// Offering by where it sits (`US-DSC-F02-001` AC-3).
  categoryPath       String   @map("category_path")
  /// Attribute display values — the label a person reads, not the identifier
  /// `filterValues` holds.
  attributeText      String   @map("attribute_text")
  /// The four searchable fields concatenated. Membership is decided here; which
  /// field matched is decided from the fields themselves.
  searchableText     String   @map("searchable_text")
  filterValues       Json     @map("filter_values")
  publishedAt        DateTime @map("published_at") @db.Timestamptz(6)
  eligibilityVersion Int      @map("eligibility_version")
  projectedAt        DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)
  offering           Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([domainId, categoryId, publishedAt])
  // Declared so the datamodel matches the trigram index created by
  // `20260725000100_initial_platform`. Prisma can see this index, so leaving it
  // undeclared reads as drift. The sibling full-text and partial indexes in that
  // migration are expression-based and remain outside what Prisma models.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "offering_search_projection_title_trgm_idx", type: Gin)
  @@map("offering_search_projection")
}

model AuditRecord {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  effectiveBusinessId String?  @map("effective_business_id") @db.Uuid
  action              String   @db.VarChar(120)
  targetType          String   @map("target_type") @db.VarChar(100)
  targetId            String?  @map("target_id") @db.Uuid
  result              String   @db.VarChar(40)
  reason              String?
  correlationId       String   @map("correlation_id") @db.Uuid
  safeMetadata        Json?    @map("safe_metadata")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_record")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(160)
  payload       Json
  /// The request that queued this event (§12.3). Nullable because rows written
  /// before `20260819000100_outbox_correlation` have no identifier to supply,
  /// and because delivery has never depended on one.
  correlationId String?   @map("correlation_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_event")
}

/// A person's rating of a **product**, and the sentence they wrote with it
/// (I62).
///
/// **It hangs off the product group, not off one seller's Offering.** The
/// Owner's rule is one line and it decides the whole shape: *"puanlama ürüne
/// ait olacak satıcıya değil"* — the rating belongs to the product, not to the
/// seller. §5.12 already says what a product is on this platform: the set of
/// Offerings sharing a `productKey`, and `coalesce(product_key, id::text)` for
/// one nobody has matched yet. That expression is `product_group_key` here, so
/// five sellers of the same phone answer with one score rather than five, and
/// a person who reads a review under the cheapest seller is reading a review
/// of the thing, not of the shop.
///
/// **`offeringId` is provenance, not identity.** It records which listing the
/// person was looking at when they wrote, which is worth keeping and is never
/// what the rating is read back by. A seller who withdraws a listing does not
/// take the product's score with them — hence `onDelete: Cascade` on the
/// account (a deleted person's words go) and on the Offering only because the
/// row would otherwise reference nothing; the aggregate survives in the other
/// members of the group.
///
/// One review per person per product: `@@unique([productGroupKey, userId])`. A
/// second opinion replaces the first rather than adding a vote, which is what
/// keeps an average an average of people rather than of submissions.
model ProductReview {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `coalesce(offering.product_key, offering.id::text)` at the moment of
  /// writing. Wide enough for either shape a group key takes.
  productGroupKey String   @map("product_group_key") @db.VarChar(64)
  offeringId      String   @map("offering_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// One to five whole stars. Half stars are an *average*, never a submission:
  /// nobody presses two and a half.
  rating          Int      @db.SmallInt
  /// The sentence, where the person wrote one. A rating without words is a
  /// complete review; words are the optional half.
  body            String?  @db.VarChar(2000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  offering Offering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productGroupKey, userId])
  @@index([productGroupKey])
  @@map("product_review")
}

/// Something a person kept (I64).
///
/// **The product, not the listing.** `productGroupKey` is
/// `coalesce(offering.product_key, offering.id::text)` — §5.12's definition —
/// so keeping a phone from the cheapest seller and returning through a dearer
/// one shows it already kept, and a seller withdrawing their listing does not
/// quietly delete somebody's favourite. `offeringId` records which listing they
/// were looking at and is never what the favourite is read back by.
///
/// The composite primary key is the rule: one person, one product, one heart.
model Favourite {
  productGroupKey String   @map("product_group_key") @db.VarChar(64)
  userId          String   @map("user_id") @db.Uuid
  offeringId      String   @map("offering_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering Offering    @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@id([userId, productGroupKey])
  /// The sort is declared because **the database has it**: `I64`'s migration
  /// created this index as `("user_id", "created_at" DESC)` and this line
  /// omitted the direction, so the datamodel and the migrated database were
  /// describing two different indexes. `prisma migrate diff` reports that as an
  /// index removed and added on the same columns — a message that reads like a
  /// no-op and means "these are not the same index".
  ///
  /// Recorded because the fix could have gone the other way and should not:
  /// the migration is applied and is not rewritten to match a datamodel that
  /// was simply less specific than it.
  ///
  /// **What the direction is not doing today.** The migration's comment gives
  /// the reason as "newest first", and `pg-favourite.repository.ts` does
  /// present newest-kept first — but it sorts in application code, because the
  /// query needs its own order for `distinct on`. So this index currently earns
  /// its keep on `user_id` alone. Whether the direction should stay is a
  /// question for whoever next touches that read; it is not answered by making
  /// the datamodel tell the truth about what exists.
  @@index([userId, createdAt(sort: Desc)])
  @@map("favourite")
}

/// A report about one listing, from the person reading it (I69).
///
/// **Not a Moderation Case, and the separation is the design.** A case is
/// opened by an Admin under `US-PLT-F06-001` and carries a governed lifecycle;
/// a report is an unverified claim by anybody, about one listing, whose whole
/// content is "somebody says this". Writing reports into `moderation_case`
/// would have made the queue an Admin reviews indistinguishable from a queue
/// anybody can fill.
model ListingReport {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId     String              @map("offering_id") @db.Uuid
  reason         ListingReportReason
  /// The person's own words, where they added any. Bounded because a report is
  /// a sentence, not a document.
  note           String?             @db.VarChar(600)
  /// Null for a Guest, which is the ordinary case: requiring an account first
  /// would collect fewer reports from exactly the people who noticed.
  reporterUserId String?             @map("reporter_user_id") @db.Uuid
  status         ListingReportStatus @default(OPEN)
  submittedAt    DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedBy     String?             @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at") @db.Timestamptz(6)

  offering Offering     @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  reporter UserAccount? @relation("ListingReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reviewer UserAccount? @relation("ListingReportReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([offeringId])
  @@map("listing_report")
}

/// What the reader says is wrong. The five the Owner's prototype offers, and
/// they are a closed list on purpose: a free-text-only report is a report
/// nobody can count.
enum ListingReportReason {
  PRICE_WRONG
  STOCK_WRONG
  WRONG_CATEGORY
  MISLEADING_INFORMATION
  LINK_BROKEN
}

/// Open until somebody has looked, then acted on or not. A dismissed report is
/// kept because it is evidence too: five dismissed reports about one listing is
/// a different fact from one.
enum ListingReportStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

/// A complementary product a listing suggests (I70).
///
/// **Curated, not derived.** The platform could compute "what goes with this"
/// from the catalogue and it would be guessing: a heading's neighbours are not
/// its complements. A row here is somebody's judgement written down, and the
/// surface carries exactly what was written.
///
/// Keyed on the Category, because the Owner's rule is about sections — every
/// listing under Otomotiv suggests tyres — and a per-listing table would ask
/// somebody to repeat that decision for every car on the site.
model ComplementaryPlacement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  label          String   @db.VarChar(120)
  /// Whose site the person will be on, named on the control itself.
  partnerName    String   @map("partner_name") @db.VarChar(160)
  note           String?  @db.VarChar(240)
  destinationUrl String   @map("destination_url") @db.VarChar(2048)
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, label])
  @@map("complementary_placement")
}

/// The advertising placement settings PRD-0006 §20.4 names (I75).
///
/// **One row with named columns, not a settings store.** §12 refuses a generic
/// Platform Configuration capability; a key-value table with an Admin form in
/// front of it is exactly the shape in which one arrives unnoticed. Adding a
/// setting here means a migration and a decision.
model AdvertisingSetting {
  /// Fixed rather than generated: a second row cannot exist to disagree with
  /// the first.
  id               Boolean   @id @default(true)
  /// The external network's publisher identifier. Empty means no network
  /// advertising anywhere, whatever the unit identifiers hold.
  publisherId      String?   @map("publisher_id") @db.VarChar(64)
  unitResults      String?   @map("unit_results") @db.VarChar(64)
  unitPresentation String?   @map("unit_presentation") @db.VarChar(64)
  unitCategory     String?   @map("unit_category") @db.VarChar(64)
  /// The master switch. `false` suppresses everything, including the
  /// platform's own complementary region.
  enabled          Boolean   @default(false)
  updatedBy        String?   @map("updated_by") @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByAccount UserAccount? @relation("AdvertisingSettingEditor", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("advertising_setting")
}

/// A Category marked ad-free (§20.4), and every Category beneath it.
model AdvertisingCategoryExclusion {
  categoryId String   @id @map("category_id") @db.Uuid
  excludedBy String?  @map("excluded_by") @db.Uuid
  excludedAt DateTime @default(now()) @map("excluded_at") @db.Timestamptz(6)

  category        Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  excludedByAccount UserAccount? @relation("AdvertisingExclusionEditor", fields: [excludedBy], references: [id], onDelete: Restrict)

  @@map("advertising_category_exclusion")
}

/// How a partner's catalogue is written (I76).
enum OfferingFeedFormat {
  XML
  JSON
}

/// Two outcomes and no third. A run either read the whole document or it did
/// not; a partial import loses half a partner's catalogue and the missing half
/// is indistinguishable from products that were withdrawn.
enum OfferingFeedRunOutcome {
  SUCCEEDED
  FAILED
}

/// I91. Why a run failed, as a value rather than as a sentence
/// (`US-PLT-F13-001` AC-9, `PRD-0006` v2.6 §24.2).
enum OfferingFeedFailureKind {
  /// The partner's server refused, timed out, or answered something too large.
  SOURCE_UNREACHABLE
  /// The document arrived and could not be parsed.
  DOCUMENT_UNREADABLE
  /// The document parsed and yielded nothing usable: the mapping names fields
  /// this document does not carry.
  MAPPING_INCOMPLETE
  /// Something else. Present so that an unexpected failure is not filed under
  /// one of the three above, which would be a category that lies.
  UNCLASSIFIED

  @@map("OfferingFeedFailureKind")
}


/// A partner catalogue the platform reads on a schedule (I76).
///
/// `PRD-0001-offering.md` §5.11 governs what the intake may do with what it
/// finds; §135 leaves the mechanism to its own documents, which is this one and
/// the `@commerce/feed` package.
///
/// The mapping is twelve named columns rather than a document. A `Json` blob
/// with a form in front of it would take a field nobody decided to support, and
/// the twelfth time somebody needed one they would add it to the form instead
/// of to a migration.
model OfferingFeed {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  /// One Category for the whole feed. A per-product Category would mean
  /// trusting a partner's taxonomy to choose a heading in this platform's, and
  /// a wrong heading is worse than a coarse one.
  categoryId      String             @map("category_id") @db.Uuid
  name            String             @db.VarChar(160)
  documentUrl     String             @map("document_url") @db.VarChar(2048)
  format          OfferingFeedFormat
  /// Where the products are inside the document, when the guess is wrong.
  itemPath        String?            @map("item_path") @db.VarChar(240)

  mapExternalId   String             @map("map_external_id") @db.VarChar(240)
  mapTitle        String             @map("map_title") @db.VarChar(240)
  mapSummary      String?            @map("map_summary") @db.VarChar(240)
  mapPrice        String?            @map("map_price") @db.VarChar(240)
  mapPriorPrice   String?            @map("map_prior_price") @db.VarChar(240)
  mapDeliveryCost String?            @map("map_delivery_cost") @db.VarChar(240)
  mapCurrency     String?            @map("map_currency") @db.VarChar(240)
  mapStock        String?            @map("map_stock") @db.VarChar(240)
  mapUrl          String?            @map("map_url") @db.VarChar(240)
  mapImageUrl     String?            @map("map_image_url") @db.VarChar(240)
  mapProductKey   String?            @map("map_product_key") @db.VarChar(240)
  mapCategoryKey  String?            @map("map_category_key") @db.VarChar(240)

  active          Boolean            @default(true)
  createdBy       String?            @map("created_by") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author          UserAccount?       @relation("OfferingFeedAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  runs            OfferingFeedRun[]
  items           OfferingFeedItem[]

  @@unique([businessId, name])
  @@index([active], map: "offering_feed_active_idx")
  @@map("offering_feed")
}

/// One sync, whether it worked.
///
/// **A failed run is the point of this table**, not an exception to it. The
/// Owner asked for the failures on the dashboard, and a log that recorded only
/// successes would answer "when did this last work" and never "why did it stop".
model OfferingFeedRun {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedId        String                    @map("feed_id") @db.Uuid
  outcome       OfferingFeedRunOutcome
  startedAt     DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime                  @default(now()) @map("finished_at") @db.Timestamptz(6)
  readCount     Int                       @default(0) @map("read_count")
  /// Zero on every run since I88, and kept because the runs that created
  /// listings happened. The intake no longer creates any.
  createdCount  Int                       @default(0) @map("created_count")
  /// I88. Products the document offered that the run did not act on: not
  /// carried by the platform, or carried and not live. Ordinary rather than
  /// wrong, which is why it is not counted as a rejection.
  skippedCount  Int                       @default(0) @map("skipped_count")
  updatedCount  Int                       @default(0) @map("updated_count")
  rejectedCount Int                       @default(0) @map("rejected_count")
  /// Products the platform holds that the document no longer offers. Counted
  /// and not acted on: retiring a listing is a lifecycle decision, and one
  /// truncated document would otherwise delete a catalogue.
  missingCount  Int                       @default(0) @map("missing_count")
  /// I78. What the Owner's 72-hour rule did on this run. On the run rather than
  /// derived from the item table: that says what is withdrawn now, this says
  /// what happened then.
  withdrawnCount Int                      @default(0) @map("withdrawn_count")
  restoredCount  Int                      @default(0) @map("restored_count")
  message       String?                   @db.VarChar(2000)
  /// I91. What kind of failure it was, where it failed. The message says what
  /// happened; this says what kind, which is what a surface can route on.
  failureKind   OfferingFeedFailureKind?  @map("failure_kind")

  feed          OfferingFeed              @relation(fields: [feedId], references: [id], onDelete: Restrict)
  rejections    OfferingFeedRejection[]

  @@index([feedId, startedAt(sort: Desc)], map: "offering_feed_run_feed_id_started_at_idx")
  @@index([outcome, startedAt(sort: Desc)], map: "offering_feed_run_outcome_started_at_idx")
  @@map("offering_feed_run")
}

/// A row one run refused, and why. Bounded per run by the intake: a feed that
/// rejects forty thousand rows has one problem, not forty thousand.
model OfferingFeedRejection {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String          @map("run_id") @db.Uuid
  externalId String?         @map("external_id") @db.VarChar(160)
  reason     String          @db.VarChar(400)

  run        OfferingFeedRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "offering_feed_rejection_run_id_idx")
  @@map("offering_feed_rejection")
}

/// What the platform holds from a feed, under the name the partner knows it by.
///
/// **This row is what keeps PRD-0001 §5.11.1 true.** An intake finds what to
/// update through here, so it can only reach an Offering it created; one a
/// Business owner authored has no row here and is unreachable. That is stronger
/// than checking `source = FEED` before every write, because it cannot be
/// forgotten at one call site.
model OfferingFeedItem {
  feedId       String       @map("feed_id") @db.Uuid
  externalId   String       @map("external_id") @db.VarChar(160)
  offeringId   String       @unique @map("offering_id") @db.Uuid
  firstSeenAt  DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Set when a successful run did not find this product, cleared when it
  /// returns. Recorded, not acted on.
  missingSince DateTime?    @map("missing_since") @db.Timestamptz(6)
  /// When the intake withdrew it (I78). Kept beside `missingSince` rather than
  /// derived from it: "the document stopped listing this" and "the platform
  /// stopped publishing it" are two events separated by the tolerance.
  withdrawnAt  DateTime?    @map("withdrawn_at") @db.Timestamptz(6)

  feed         OfferingFeed @relation(fields: [feedId], references: [id], onDelete: Restrict)
  offering     Offering     @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([feedId, externalId])
  @@map("offering_feed_item")
}


/// Enum for the Admin audit trail (I83).
enum AdminAuditAction {
  PII_VIEW
  REQUEST_CORRECTION
  HIDE_OFFERING
  RESTORE_OFFERING
  RESTRICT_BUSINESS
  RESTORE_BUSINESS
  SUSPEND_USER
  REINSTATE_USER
  CASE_OPEN
  /// I87. The affiliate destination's four Admin acts, validation split by its
  /// result: the row carries no free text, so one `VALIDATE_DESTINATION` would
  /// record that somebody judged an address and lose what they decided.
  REVIEW_DESTINATION
  VALIDATE_DESTINATION_VALID
  VALIDATE_DESTINATION_INVALID
  ENABLE_DESTINATION
  DISABLE_DESTINATION
  /// I93. The five editorial acts of `PRD-0009` **Frozen v0.4** §13.8.
  ///
  /// **`CREATE_EDITORIAL_REVIEW` is recorded by the Owner's decision of
  /// 2026-09-09**, taken on a defect found while writing this schema: §13.8
  /// names five acts and the §22.2 row added in `PRD-0006` v2.7 names four,
  /// having dropped "Creating" when the amendment was drafted. Recording the
  /// five was chosen because under-recording is the failure §22 exists to
  /// prevent. `PRD-0006` **Frozen v2.8** (2026-09-16) restores the word to
  /// §22.2, so the document and this enum now name the same five acts.
  ///
  /// The migration that added these values still describes v2.8 as pending. It
  /// is left exactly as written: an applied migration is checksummed by
  /// `prisma migrate deploy`, and editing one — even a comment — makes every
  /// database that already ran it refuse the next deploy.
  CREATE_EDITORIAL_REVIEW
  PUBLISH_EDITORIAL_REVIEW
  REVISE_EDITORIAL_REVIEW
  RECHECK_EDITORIAL_REVIEW
  WITHDRAW_EDITORIAL_REVIEW

  @@map("AdminAuditAction")
}

/// What an Admin did, and when (I83).
///
/// **Append-only, and the migration enforces it with triggers on UPDATE,
/// DELETE and TRUNCATE.** Prisma cannot express that, so it is stated here for
/// a reader and guaranteed there. This model exists for the build-time schema
/// only, like every other one in this file: every runtime read and write is
/// hand-written SQL.
///
/// `actorId` is `Restrict` on purpose — an account that has acted as an Admin
/// cannot be deleted out from under its own audit rows, because cascading would
/// let removing a user erase the record of what they did.
model AdminAuditEvent {
  id         BigInt           @id @default(autoincrement())
  actorId    String           @map("actor_id") @db.Uuid
  actionType AdminAuditAction @map("action_type")
  /// Absent where an action has no single target outside its case. A fabricated
  /// one would be worse than an absent one.
  targetId   String?          @map("target_id") @db.Uuid
  /// The case the action was taken under. This is what turns "somebody viewed
  /// an address" into "this address was viewed while working case X".
  caseId     String?          @map("case_id") @db.Uuid
  occurredAt DateTime         @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor      UserAccount      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, occurredAt(sort: Desc)])
  @@index([targetId, occurredAt(sort: Desc)])
  @@map("admin_audit_event")
}

/// The three states of an editorial review. `PRD-0009` **Frozen v0.4** §13.3.
///
/// `WITHDRAWN` is why this is an enum and not a boolean. It exists so that
/// taking down a published judgement is not a database operation: without it
/// the only remedy for a review that turns out to be wrong is an operator
/// editing rows, which is the first of the three risks §13 was written to close
/// arriving through the back door of the document that closes it.
///
/// Withdrawal is not deletion. The review stops being presented; that it
/// existed, and who withdrew it, stays in `admin_audit_event`.
enum EditorialReviewStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN

  @@map("EditorialReviewStatus")
}

/// `PRD-0009` §5 — the two lists, kept apart because a review with no cons is
/// an advertisement.
enum EditorialPointKind {
  PRO
  CON

  @@map("EditorialPointKind")
}

/// The platform's own judgement of a product (I93). Feature `EDT F01`
/// presents it; `EDT F02` writes it. Behaviour owner: `PRD-0009` **Frozen
/// v0.4**.
///
/// **`productKey` is a real `offering.product_key` and never the `coalesce`
/// fallback**, which is the one place this table refuses to follow
/// `product_review` and `favourite`. Those group by
/// `coalesce(offering.product_key, offering.id::text)`, so a listing with no
/// key becomes a group of one named after the listing. A review written
/// against such a group would be attached to an Offering wearing a Product
/// Key's name and would vanish with that Offering — the exact failure
/// `US-EDT-F01-001` AC-9 exists to prevent, reached through the convenience
/// meant to help. `US-EDT-F02-001` AC-1 and AC-14 leave one reading: a real
/// key, or no review.
///
/// **There is no foreign key to `offering`, and that is a decision rather than
/// an omission.** AC-14 requires the key to exist in the catalogue when the
/// review is written; AC-9 requires the review to survive every Offering
/// carrying that key being retired, hidden or withdrawn. A foreign key would
/// serve the first by defeating the second. Existence is therefore checked
/// inside the write transaction, where there is no window between the check and
/// the write.
///
/// **There is no `businessId` either, and the absence is the isolation
/// boundary.** This is platform-owned material like `category` and
/// `admin_audit_event`. No seller can reach the judgement written about the
/// product they sell, because no column expresses the relationship — which is
/// also the structural half of AC-16: there is no sponsor, partner, commission,
/// promotion or reason column, and no JSON document that could carry one. A
/// prohibition is only as good as the shapes that can carry a violation.
///
/// **`lastCheckedAt` is deliberately not called `updatedAt`.** Every other
/// table here sets `updated_at = now()` on write, and the day somebody follows
/// that habit on this table is the day AC-9 breaks silently: "last re-checked"
/// would come to mean "last touched", a corrected comma would present as a
/// fresh verification, and the date a reader is invited to trust would be the
/// least trustworthy thing on the page. Row bookkeeping is `rowRevisedAt`. No
/// column here invites the wrong write.
model EditorialReview {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique across every state, withdrawn included (AC-15). A withdrawn review
  /// therefore occupies its key permanently, because nothing deletes one
  /// (AC-7); the remedy for a wrong judgement is to revise and republish the
  /// review that exists, which is what §13.5 means by "a second is a revision
  /// of the first, not a second review".
  productKey    String                @unique @map("product_key") @db.VarChar(64)
  status        EditorialReviewStatus @default(DRAFT)
  /// One line. Required to publish, absent while a Draft is being written.
  verdict       String?               @db.VarChar(280)
  /// `0`–`10` with one decimal, held as exact decimal rather than a float, and
  /// deliberately not the crowd's `0`–`5` (§5.2). The two are never merged,
  /// averaged, or derived from one another.
  score         Decimal?              @db.Decimal(3, 1)
  /// Published content: whose judgement this is offered as (§13.2). Never
  /// derived from the acting account, which lives in the audit trail and is
  /// never presented.
  byline        String?               @map("byline") @db.VarChar(120)
  /// Set once, at first publication, and never again — including across a
  /// withdrawal and a republication.
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(6)
  /// Moved only by a deliberate re-check. See the note above.
  lastCheckedAt DateTime?             @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Ordinary row bookkeeping, carrying no claim to a reader.
  rowRevisedAt  DateTime              @default(now()) @map("row_revised_at") @db.Timestamptz(6)

  sections EditorialReviewSection[]
  points   EditorialReviewPoint[]

  @@map("editorial_review")
}

/// A headed passage of prose (`PRD-0009` §5).
///
/// A child table rather than a JSON array, for AC-16's reason: a document field
/// can express anything, sponsorship included. Named columns cannot.
model EditorialReviewSection {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  /// Author-chosen order. Presentation follows it; nothing sorts by content.
  position Int    @db.SmallInt
  heading  String @db.VarChar(160)
  body     String @db.VarChar(8000)

  review EditorialReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, position])
  @@map("editorial_review_section")
}

/// One entry in the pros list or the cons list (`PRD-0009` §5).
///
/// One table with a `kind` rather than two tables, so that "at least one of
/// each" — the §13.5 rule that keeps a review from being an advertisement — is
/// one query rather than two that can disagree.
model EditorialReviewPoint {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId String             @map("review_id") @db.Uuid
  kind     EditorialPointKind
  position Int                @db.SmallInt
  text     String             @db.VarChar(280)

  review EditorialReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, kind, position])
