generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

/// `US-IDN-F06-001` AC-1 fixes the V1 vocabulary at exactly these two values.
/// A registration awaiting email-control proof is not an account at all, so it
/// has no status here — see `PendingRegistration`.
enum AccountStatus {
  ENABLED
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

/// The Business-side input to public exposure (`US-BUS-F01-001` AC-5). Distinct
/// from moderation: `US-BUS-F02-001` AC-7 reads both before any public identity
/// is shown.
enum BusinessExposureInput {
  ELIGIBLE
  INELIGIBLE
}

enum BusinessModerationStatus {
  UNRESTRICTED
  RESTRICTED
}

/// A General Moderation Case is Open until PRD-0006 explicitly closes it
/// (`US-BUS-F07-001` AC-12, AC-15). An owner response never moves it.
enum ModerationCaseStatus {
  OPEN
  CLOSED
}

/// What a General Moderation case is about (`US-PLT-F02-001`).
enum ModerationTargetType {
  OFFERING
  BUSINESS
  USER_ACCOUNT
}

/// The exact seven General Moderation actions of PRD-0006 §7 and Owner
/// Decision D15/D16. Affiliate Destination Review, Validate, Enable and
/// Disable are absent: they are a separate action family (AC-10).
enum ModerationAction {
  REQUEST_CORRECTION
  HIDE_OFFERING
  RESTORE_OFFERING
  RESTRICT_BUSINESS
  RESTORE_BUSINESS
  SUSPEND_USER
  REINSTATE_USER
}

/// The four Business-owned Request Correction targets of PRD-0005 §12.1.
/// `USER_ACCOUNT` is absent, which is AC-2: User Account correction is outside
/// V1, so it is not a value a notice can take.
enum CorrectionTarget {
  BUSINESS_INFORMATION
  OFFERING_CONTENT
  AFFILIATE_DESTINATION_CONFIGURATION
  DIRECT_CONTACT_INFORMATION
}

/// The parts of Offering content a correction may aim at. Category is absent:
/// a correction fixes what an Offering says, it does not move the Offering to
/// another part of the catalogue while its Business is Restricted.
enum OfferingContentArea {
  TITLE
  SUMMARY
  ATTRIBUTES
}

/// The four Offering lifecycle states of PRD-0001 §6. `Hidden` is an Admin
/// removal from circulation that keeps its publication history; `Archived` is
/// the terminal result of owner retirement.
enum OfferingStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

/// The five V1 Attribute value kinds (`US-PLT-F09-001` AC-2). `Number` covers
/// what were separate integer and decimal kinds; the two Select kinds differ
/// only in how many allowed values one Offering may hold.
enum AttributeValueKind {
  TEXT
  NUMBER
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
}

/// PRD-0001 v4.0 §5.10.1. Three answers, and they are three because two of
/// them are already confused everywhere else.
///
/// `ON_REQUEST` is a property of the **Offering**: a consultancy, a repair, a
/// bespoke installation genuinely has no amount until the work is specified,
/// and the amount is settled after the Handoff. `UNKNOWN` is a property of the
/// **platform's knowledge**: a feed carried no amount, or none has been read
/// yet.
///
/// Showing a service Offering as "price unknown" tells a person the platform
/// has failed when nothing has failed. This is the same distinction PRD-0002
/// §14 draws between zero results and results unavailable.
enum PricingKind {
  FIXED
  ON_REQUEST
  UNKNOWN
}

/// PRD-0001 v4.0 §5.10.3. Stock is a third state rather than a boolean,
/// because "we do not know" is an answer a feed gives constantly and a
/// two-valued column would have to lie about it.
enum StockState {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

/// PRD-0001 v4.0 §5.11. How the record came to exist, and nothing more.
///
/// §5.11.2 is explicit that this confers no authority: a `FEED` Offering is
/// moderated exactly as a `BUSINESS` one is. What it does govern is §5.11.1 —
/// an automated intake may modify only what it created, because an intake that
/// overwrites a typed correction destroys a decision and leaves no trace.
enum OfferingSource {
  MANUAL
  FEED
  BUSINESS
}

/// PRD-0001 §9.3. `Enabled` and `Disabled` are reached only through the
/// Platform administration actions PRD-0006 owns; a Business owner's authoring
/// always lands on `DRAFT`.
enum AffiliateDestinationStatus {
  DRAFT
  ENABLED
  DISABLED
}

/// PRD-0001 §9.4. `NOT_VALIDATED` means the *current* configuration has no
/// current result — which is why changing the configuration returns to it.
enum AffiliateValidationResult {
  NOT_VALIDATED
  VALID
  INVALID
}

enum HandoffEligibility {
  ELIGIBLE
  INELIGIBLE
}

/// The complete V1 Direct Contact channel set (`US-DEC-F06-001` AC-4,
/// PRD-0004). An enum rather than a string: a fourth channel is not a value
/// this can hold.
enum DirectContactChannel {
  TELEPHONE
  EMAIL
  URL
}

enum PublicationStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  WITHDRAWN
}

model UserAccount {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String          @unique @db.VarChar(320)
  emailVerifiedAt DateTime        @map("email_verified_at") @db.Timestamptz(6)
  status          AccountStatus   @default(ENABLED)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessOwners  BusinessOwner[]
  credential      UserCredential?
  sessions        UserSession[]
  passwordReset   PasswordReset?
  adminAuthorization AdminAuthorization?
  affiliateReviews   AffiliateDestinationReview[] @relation("AffiliateReviewer")
  affiliateValidations AffiliateDestination[]     @relation("AffiliateValidator")
  directContactReveals DirectContactReveal[]
  openedCases          ModerationCase[]           @relation("CaseOpener")
  closedCases          ModerationCase[]           @relation("CaseCloser")
  moderationCases      ModerationCase[]           @relation("CaseSubject")
  moderationResolutions ModerationResolution[]    @relation("ResolutionRecorder")
  correctionReviews     CorrectionReview[]        @relation("CorrectionReviewer")
  correctionRequests   CorrectionRequest[]        @relation("CorrectionRequester")
  correctionEdits      CorrectionEdit[]           @relation("CorrectionEditor")

  @@map("user_account")
}

/// Admin authorization attached to an existing account (`US-IDN-F08-001` AC-1).
/// Granted and removed only by controlled operational provisioning, never
/// through the product API (AC-3, AC-4).
model AdminAuthorization {
  userId    String      @id @map("user_id") @db.Uuid
  grantedBy String      @map("granted_by") @db.VarChar(160)
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_authorization")
}

/// A recovery in progress. Like a pending registration, it holds no usable
/// token until the worker dispatches its message.
model PasswordReset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  tokenHash    String?   @unique @map("token_hash") @db.Char(64)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset")
}

/// Credentials are isolated from the account so they can be rotated, audited or
/// replaced by an external provider without touching the product-owned User
/// model (ADR-0012 §7).
model UserCredential {
  userId       String      @id @map("user_id") @db.Uuid
  passwordHash String      @map("password_hash")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

/// A registration that has not yet proven control of its email address.
/// `US-IDN-F02-001` AC-7 forbids representing this as an account state, so it is
/// deliberately a separate record that becomes a `UserAccount` only on proof.
model PendingRegistration {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash")
  /// Absent until the message is dispatched. The token is minted at delivery so
  /// that no replayable secret is ever written to the database.
  tokenHash    String?   @unique @map("token_hash") @db.Char(64)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("pending_registration")
}

/// The browser holds a high-entropy opaque identifier; only its digest is
/// stored, so a database disclosure cannot be replayed as a live session
/// (ADR-0012 §2).
model UserSession {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  tokenHash          String      @unique @map("token_hash") @db.Char(64)
  /// Explicitly chosen, never inferred (`US-IDN-F07-001` AC-3). Null means the
  /// person is in the authenticated User baseline, not in any Business.
  selectedBusinessId String?     @map("selected_business_id") @db.Uuid
  /// Entered explicitly and re-evaluated per request (`US-IDN-F08-001` AC-11).
  adminContext       Boolean     @default(false) @map("admin_context")
  issuedAt           DateTime    @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt         DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?   @map("revoked_at") @db.Timestamptz(6)
  user               UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedBusiness   Business?   @relation(fields: [selectedBusinessId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([selectedBusinessId])
  @@map("user_session")
}

/// Throttling state for authentication attempts. Keyed by a digest so the
/// subject (an email address or client address) is never stored in clear text.
model AuthThrottle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String   @db.VarChar(40)
  subjectHash String   @map("subject_hash") @db.Char(64)
  attempts    Int      @default(0)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@unique([scope, subjectHash])
  @@index([firstSeenAt])
  @@map("auth_throttle")
}

model Business {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String          @unique @db.VarChar(120)
  name      String          @db.VarChar(200)
  status    BusinessStatus  @default(DRAFT)
  publicExposure BusinessExposureInput @default(ELIGIBLE) @map("public_exposure")
  /// Public Business identity set — display name plus these two only
  /// (`US-BUS-F02-001` AC-6).
  logoUrl          String? @map("logo_url") @db.VarChar(2048)
  shortDescription String? @map("short_description") @db.VarChar(500)
  /// Protected Direct Contact channels. Never public (AC-9); released only
  /// through PRD-0004 to an Enabled authenticated User (AC-10).
  contactTelephone String? @map("contact_telephone") @db.VarChar(40)
  contactEmail     String? @map("contact_email") @db.VarChar(320)
  contactUrl       String? @map("contact_url") @db.VarChar(2048)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owners    BusinessOwner[]
  offerings Offering[]
  moderationState BusinessModerationState?
  selectedInSessions UserSession[]
  moderationCases ModerationCase[]

  @@map("business")
}

model BusinessModerationState {
  businessId String                   @id @map("business_id") @db.Uuid
  status     BusinessModerationStatus @default(UNRESTRICTED)
  reasonCode String?                  @map("reason_code") @db.VarChar(100)
  updatedAt  DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_moderation_state")
}

/// A General Moderation Case (PRD-0006 §7.3). Business responds to it; only
/// Platform opens, re-reviews and closes it.
model ModerationCase {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType ModerationTargetType @map("target_type")
  /// Exactly one target, and the Business a case concerns present wherever
  /// there is one to name — an Offering case carries both.
  offeringId String?              @map("offering_id") @db.Uuid
  businessId String?              @map("business_id") @db.Uuid
  userId     String?              @map("user_id") @db.Uuid
  status     ModerationCaseStatus @default(OPEN)
  openedBy   String               @map("opened_by") @db.Uuid
  openedAt   DateTime             @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedBy   String?              @map("closed_by") @db.Uuid
  closedAt   DateTime?            @map("closed_at") @db.Timestamptz(6)
  offering   Offering?            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  business   Business?            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       UserAccount?         @relation("CaseSubject", fields: [userId], references: [id], onDelete: Restrict)
  opener     UserAccount          @relation("CaseOpener", fields: [openedBy], references: [id], onDelete: Restrict)
  closer     UserAccount?         @relation("CaseCloser", fields: [closedBy], references: [id], onDelete: Restrict)
  corrections CorrectionRequest[]
  resolutions ModerationResolution[]
  reviews     CorrectionReview[]

  @@unique([id, businessId], map: "moderation_case_id_business_id_key")
  @@index([businessId, status])
  @@index([targetType, status])
  @@map("moderation_case")
}

/// One recorded re-review of an owner's correction response
/// (`US-PLT-F06-001` AC-10). Closure needs one dated after the most recent
/// owner edit — an earlier review cannot stand in for a later response.
model CorrectionReview {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  note           String?        @db.VarChar(1000)
  reviewedBy     String         @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime       @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewer       UserAccount    @relation("CorrectionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([caseId, reviewedAt])
  @@map("correction_review")
}

/// One applied action or one recorded no-action decision. Closure reads these
/// rather than a flag, because a flag can be set by something that did not do
/// the work (`US-PLT-F02-001` AC-7).
model ModerationResolution {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId         String            @map("case_id") @db.Uuid
  action         ModerationAction?
  noActionReason String?           @map("no_action_reason") @db.VarChar(1000)
  recordedBy     String            @map("recorded_by") @db.Uuid
  recordedAt     DateTime          @default(now()) @map("recorded_at") @db.Timestamptz(6)
  moderationCase ModerationCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recorder       UserAccount       @relation("ResolutionRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([caseId, recordedAt])
  @@map("moderation_resolution")
}

/// One recorded Request Correction. The Offering and content area are present
/// exactly when the target is Offering content, which a CHECK enforces in both
/// directions.
model CorrectionRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String               @map("case_id") @db.Uuid
  businessId  String               @map("business_id") @db.Uuid
  target      CorrectionTarget
  offeringId  String?              @map("offering_id") @db.Uuid
  contentArea OfferingContentArea? @map("content_area")
  note        String?              @db.VarChar(1000)
  requestedBy String               @map("requested_by") @db.Uuid
  requestedAt DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  moderationCase ModerationCase    @relation(fields: [caseId, businessId], references: [id, businessId], onDelete: Cascade, map: "correction_request_case_fkey")
  offering    Offering?            @relation(fields: [offeringId, businessId], references: [id, businessId], onDelete: Restrict, map: "correction_request_offering_fkey")
  requester   UserAccount          @relation("CorrectionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  edits       CorrectionEdit[]

  @@index([businessId, requestedAt])
  @@index([caseId])
  @@map("correction_request")
}

/// One saved owner response. Its existence is what makes Platform re-review
/// outstanding (`US-BUS-F07-001` AC-14) — no separate flag to forget.
model CorrectionEdit {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionRequestId String              @map("correction_request_id") @db.Uuid
  offeringId          String              @map("offering_id") @db.Uuid
  contentArea         OfferingContentArea @map("content_area")
  editedBy            String              @map("edited_by") @db.Uuid
  editedAt            DateTime            @default(now()) @map("edited_at") @db.Timestamptz(6)
  request             CorrectionRequest   @relation(fields: [correctionRequestId], references: [id], onDelete: Cascade)
  offering            Offering            @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  editor              UserAccount         @relation("CorrectionEditor", fields: [editedBy], references: [id], onDelete: Restrict)

  @@index([correctionRequestId])
  @@map("correction_edit")
}

model BusinessOwner {
  businessId String      @map("business_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([businessId, userId])
  /// Exactly one owner per Business in V1 (`US-BUS-F01-001` AC-8, AC-10).
  @@unique([businessId])
  @@index([userId])
  @@map("business_owner")
}

model Domain {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stableKey  String     @unique @map("stable_key") @db.VarChar(80)
  slug       String     @unique @db.VarChar(120)
  name       String     @db.VarChar(160)
  active     Boolean    @default(true)
  categories Category[]
  discoveryStarts DiscoveryStart[]
  presentationOpens OfferingPresentationOpen[]
  compareStarts CompareStart[]

  @@map("domain")
}

enum DiscoveryPathKind {
  BROWSE
  SEARCH
}

/// A bounded occurrence: a person began looking (PRD-0002 §5.10). One per path,
/// so a descendant Category selection inside the same Browse path adds none
/// (`US-DSC-F03-001` AC-8). PRD-0006 Basic Analytics is its only consumer.
model DiscoveryStart {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pathId    String            @unique @map("path_id") @db.Uuid
  kind      DiscoveryPathKind
  /// Inherited from the selected Category for a Browse Start (AC-2).
  domainId  String?           @map("domain_id") @db.Uuid
  startedAt DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  domain    Domain?           @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([kind, startedAt])
  @@map("discovery_start")
}

/// One occurrence of complete public Presentation successfully beginning for
/// one eligible Offering (PRD-0001 §8.2.1). A management view produces none.
model OfferingPresentationOpen {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  /// Denormalised: the occurrence belongs to the Domain it happened in, even
  /// if the Offering is recategorised afterwards.
  domainId   String   @map("domain_id") @db.Uuid
  openedAt   DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([offeringId, openedAt])
  @@index([domainId, openedAt])
  @@map("offering_presentation_open")
}

/// Current-flow Compare state (`US-DEC-F01-001`). Not history and not a
/// session: it expires, and PRD-0003 gives V1 no saved Compare history.
model ComparisonSet {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The shared active leaf Category every member must belong to (AC-3).
  categoryId String                @map("category_id") @db.Uuid
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime              @map("expires_at") @db.Timestamptz(6)
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  members    ComparisonSetMember[]
  decisionFlows DecisionFlow[]

  @@index([expiresAt])
  @@map("comparison_set")
}

/// Membership. Eligibility, the shared leaf and the ceiling of five are
/// enforced by a trigger, which Prisma cannot model — the integration suites
/// are what prove they are there.
model ComparisonSetMember {
  comparisonSetId String        @map("comparison_set_id") @db.Uuid
  offeringId      String        @map("offering_id") @db.Uuid
  addedAt         DateTime      @default(now()) @map("added_at") @db.Timestamptz(6)
  comparisonSet   ComparisonSet @relation(fields: [comparisonSetId], references: [id], onDelete: Cascade)
  offering        Offering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@id([comparisonSetId, offeringId])
  @@index([offeringId])
  @@map("comparison_set_member")
}

/// The current Decision flow (`US-DEC-F02-001`). Its context is exactly one
/// eligible Offering or one Comparison Set — a database CHECK, because a
/// context holding two things would let Chat speak about something the person
/// never chose. It carries no person and expires on its own, which is how AC-6
/// forbids a personal Decision history by construction.
model DecisionFlow {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId      String?        @map("offering_id") @db.Uuid
  comparisonSetId String?        @map("comparison_set_id") @db.Uuid
  /// The one Offering this flow is about to act on (`US-DEC-F04-001`). Null is
  /// the normal starting state: every handoff waits for an explicit act. A
  /// trigger restricts it to the context, and clears it when the selected
  /// member leaves a Comparison Set.
  selectedOfferingId String?     @map("selected_offering_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  offering        Offering?      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  comparisonSet   ComparisonSet? @relation(fields: [comparisonSetId], references: [id], onDelete: Cascade)
  selectedOffering Offering?     @relation("DecisionSelection", fields: [selectedOfferingId], references: [id], onDelete: Restrict)
  turns           DecisionChatTurn[]

  @@index([expiresAt])
  @@map("decision_flow")
}

/// One question and its reply, for the current flow only (`US-DEC-F03-001`
/// AC-9). Removed with the flow, and carrying no person.
model DecisionChatTurn {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String       @map("decision_flow_id") @db.Uuid
  position       Int
  question       String
  reply          String
  askedAt        DateTime     @default(now()) @map("asked_at") @db.Timestamptz(6)
  decisionFlow   DecisionFlow @relation(fields: [decisionFlowId], references: [id], onDelete: Cascade)

  /// The migration names this constraint for what it means rather than by
  /// Prisma's default, so the datamodel says which name it expects. Without the
  /// map the drift gate sees a rename on every run.
  @@unique([decisionFlowId, position], map: "decision_chat_turn_unique_position")
  @@map("decision_chat_turn")
}

/// One successful Affiliate Handoff initiation (`US-DEC-F05-001` AC-8), which
/// `US-DEC-F07-001` consumes as Affiliate Handoff Completion. It records that
/// an external destination was made active and nothing about what happened
/// there. The flow reference is not a foreign key on purpose: the flow expires
/// and the initiation must outlive it.
model AffiliateHandoff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String   @map("decision_flow_id") @db.Uuid
  offeringId     String   @map("offering_id") @db.Uuid
  /// The exact address made active, as it stood at that moment.
  destination    String   @db.VarChar(2048)
  initiatedAt    DateTime @default(now()) @map("initiated_at") @db.Timestamptz(6)
  offering       Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@index([offeringId, initiatedAt])
  @@index([decisionFlowId])
  @@map("affiliate_handoff")
}

/// One successful Direct Contact reveal (`US-DEC-F06-001` AC-10), which
/// `US-DEC-F07-001` consumes as Direct Contact Completion. It records which
/// channel was revealed and to whom, and nothing about what followed — there is
/// no message, inbox, conversation or reply here, and the revealed value itself
/// is absent because a log of it would be a second place it could leak from.
model DirectContactReveal {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  decisionFlowId String               @map("decision_flow_id") @db.Uuid
  offeringId     String               @map("offering_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  channel        DirectContactChannel
  revealedAt     DateTime             @default(now()) @map("revealed_at") @db.Timestamptz(6)
  offering       Offering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  user           UserAccount          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([offeringId, revealedAt])
  @@index([decisionFlowId])
  @@map("direct_contact_reveal")
}

/// One occurrence of assistive Chat beginning on a valid Decision Context
/// (AC-3). One per flow, and it outlives the flow: that Chat began is a fact
/// about the past, not current-flow state.
model DecisionChatStart {
  decisionFlowId String   @id @map("decision_flow_id") @db.Uuid
  startedAt      DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@map("decision_chat_start")
}

/// One occurrence of a valid Comparison Set being opened in Compare (AC-11).
/// One per set, so reopening the same comparison is not counted twice.
model CompareStart {
  comparisonSetId String   @id @map("comparison_set_id") @db.Uuid
  domainId        String   @map("domain_id") @db.Uuid
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([domainId, startedAt])
  @@map("compare_start")
}

model Category {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId   String              @map("domain_id") @db.Uuid
  parentId   String?             @map("parent_id") @db.Uuid
  stableKey  String              @unique @map("stable_key") @db.VarChar(100)
  slug       String              @db.VarChar(120)
  name       String              @db.VarChar(160)
  active     Boolean             @default(true)
  domain     Domain              @relation(fields: [domainId], references: [id], onDelete: Restrict)
  /// The parent reference carries the Domain as well as the identifier, so a
  /// child can only point at a parent that already agrees with it
  /// (`US-PLT-F08-001` AC-7, AC-10). Cross-Domain parenting is a foreign key
  /// violation rather than a rule someone has to remember to check.
  parent     Category?           @relation("CategoryTree", fields: [parentId, domainId], references: [id, domainId], onDelete: Restrict, onUpdate: Restrict)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  offerings  Offering[]
  comparisonSets ComparisonSet[]

  @@unique([id, domainId])
  @@unique([domainId, slug])
  @@index([parentId])
  @@map("category")
}

model AttributeDefinition {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stableKey  String                   @unique @map("stable_key") @db.VarChar(100)
  name       String                   @db.VarChar(160)
  valueKind  AttributeValueKind       @map("value_kind")
  /// A governed label, and only for `NUMBER` (AC-3).
  unit       String?                  @db.VarChar(40)
  searchable Boolean                  @default(false)
  filterable Boolean                  @default(false)
  comparable Boolean                  @default(false)
  /// Owned by the definition rather than by each applicability link: AC-7
  /// evaluates it across every applicable Category at once.
  requiredForPublication Boolean      @default(false) @map("required_for_publication")
  active     Boolean                  @default(true)
  options    AttributeOption[]
  categories CategoryAttribute[]
  values     OfferingAttributeValue[]

  @@map("attribute_definition")
}

model AttributeOption {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeDefinitionId String                   @map("attribute_definition_id") @db.Uuid
  stableKey             String                   @map("stable_key") @db.VarChar(100)
  label                 String                   @db.VarChar(160)
  sortOrder             Int                      @default(0) @map("sort_order")
  active                Boolean                  @default(true)
  attributeDefinition   AttributeDefinition      @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  offeringValues        OfferingAttributeValue[]

  @@unique([attributeDefinitionId, stableKey])
  @@map("attribute_option")
}

model CategoryAttribute {
  categoryId            String              @map("category_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  sortOrder             Int                 @default(0) @map("sort_order")
  category              Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeDefinitionId])
  @@map("category_attribute")
}

model Offering {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String                    @map("business_id") @db.Uuid
  categoryId   String                    @map("category_id") @db.Uuid
  slug         String                    @db.VarChar(160)
  title        String                    @db.VarChar(240)
  summary      String?                   @db.VarChar(1000)
  status       OfferingStatus            @default(DRAFT)
  version      Int                       @default(1)

  /// PRD-0001 v4.0 §5.10. The Kind is the fact; the amount is a detail of one
  /// of the three Kinds. `UNKNOWN` is the default because that is what is true
  /// of an Offering nobody has priced yet.
  pricingKind  PricingKind               @default(UNKNOWN) @map("pricing_kind")
  /// Minor-unit precision without float arithmetic. `NUMERIC(12,2)` holds a
  /// price to ten billion lira; money in a `double` is a rounding error waiting
  /// for a large enough catalogue.
  amount       Decimal?                  @db.Decimal(12, 2)
  /// ISO 4217. Fixed width so a three-letter code cannot be stored as four.
  currency     String?                   @db.Char(3)
  /// §5.10.3: **a price without an instant is not a price.** A surface showing
  /// an amount must be able to say when it was true.
  amountSetAt  DateTime?                 @map("amount_set_at") @db.Timestamptz(6)
  /// The prior amount, so a reduction can be shown. §5.10.4 forbids storing the
  /// percentage: a stored percentage is a second copy of a fact that can
  /// disagree with the two amounts it came from.
  priorAmount  Decimal?                  @map("prior_amount") @db.Decimal(12, 2)
  /// Separable delivery charge. `0` is free delivery and `null` is "not
  /// stated"; §5.10.5 orders on amount **plus** this, because ordering on the
  /// sticker price while delivery differs makes the ordering wrong.
  deliveryCost Decimal?                  @map("delivery_cost") @db.Decimal(12, 2)
  stockState   StockState                @default(UNKNOWN) @map("stock_state")

  /// PRD-0001 v4.0 §5.11. Provenance, and §5.11.2 is explicit that it confers
  /// no authority.
  source       OfferingSource            @default(BUSINESS)

  /// PRD-0001 v4.0 §5.12. A matching hint, not an identity: Offerings sharing
  /// one may be presented together, and §5.12.3 forbids grouping on anything
  /// else. Most Offerings in most Domains will never carry one.
  productKey   String?                   @map("product_key") @db.VarChar(64)

  publishedAt  DateTime?                 @map("published_at") @db.Timestamptz(6)
  archivedAt   DateTime?                 @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  business     Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category     Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes   OfferingAttributeValue[]
  visuals      OfferingVisual[]
  publications OfferingPublication[]
  projection   OfferingSearchProjection?
  /// Zero or one, never shared (PRD-0001 §9.1).
  affiliateDestination AffiliateDestination?
  presentationOpens    OfferingPresentationOpen[]
  comparisonMemberships ComparisonSetMember[]
  decisionFlows         DecisionFlow[]
  decisionSelections    DecisionFlow[] @relation("DecisionSelection")
  affiliateHandoffs     AffiliateHandoff[]
  directContactReveals  DirectContactReveal[]
  correctionRequests    CorrectionRequest[]
  correctionEdits       CorrectionEdit[]
  moderationCases       ModerationCase[]

  @@unique([businessId, slug])
  @@unique([id, businessId], map: "offering_id_business_id_key")
  @@index([categoryId, status])
  @@map("offering")
}

/// One value an Offering holds for one Attribute definition. A `MULTI_SELECT`
/// definition is several of these rows; every other kind is exactly one
/// (`US-OFR-F02-001`).
model OfferingAttributeValue {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId            String              @map("offering_id") @db.Uuid
  attributeDefinitionId String              @map("attribute_definition_id") @db.Uuid
  textValue             String?             @map("text_value")
  numberValue           Decimal?            @map("number_value") @db.Decimal(24, 8)
  booleanValue          Boolean?            @map("boolean_value")
  optionId              String?             @map("option_id") @db.Uuid
  offering              Offering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option                AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([attributeDefinitionId])
  @@map("offering_attribute_value")
}

/// A visual supplied for one Offering (`US-OFR-F05-001` AC-4, `US-DSC-F06-001`
/// AC-4, UX-0003 §8.2).
///
/// **An address, not bytes.** `Business.logoUrl` has held an image this way
/// since I1, so this follows the platform's existing answer rather than
/// introducing a second one — and object storage would need a hosting target,
/// which does not exist yet.
///
/// `position` is the order the set is inspected in and `0` is the primary
/// visual, so "which one goes on the Listing Card" is a fact about the data
/// rather than a rule some reader has to know. The unique constraint makes two
/// primaries unrepresentable.
model OfferingVisual {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId String   @map("offering_id") @db.Uuid
  position   Int
  url        String   @db.VarChar(2048)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, position])
  @@map("offering_visual")
}

/// A distinct object associated with exactly one Offering, not a field on it
/// (`US-OFR-F06-001`, PRD-0001 §9.1).
model AffiliateDestination {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId        String                     @unique @map("offering_id") @db.Uuid
  reference         String                     @db.VarChar(2048)
  status            AffiliateDestinationStatus @default(DRAFT)
  validationResult  AffiliateValidationResult  @default(NOT_VALIDATED) @map("validation_result")
  /// Why the current result was reached. PRD-0001 §9.4 defines what `Valid`
  /// and `Invalid` mean and leaves the method open, so this records an outcome
  /// rather than a mechanism.
  validationReason  String?                    @map("validation_reason") @db.VarChar(1000)
  validatedAt       DateTime?                  @map("validated_at") @db.Timestamptz(6)
  validatedBy       String?                    @map("validated_by") @db.Uuid
  handoffEligibility HandoffEligibility        @default(INELIGIBLE) @map("handoff_eligibility")
  version           Int                        @default(1)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  offering          Offering                   @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  validator         UserAccount?               @relation("AffiliateValidator", fields: [validatedBy], references: [id], onDelete: Restrict)
  reviews           AffiliateDestinationReview[]

  @@map("affiliate_destination")
}

/// Evidence that an approved Admin review happened. `US-OFR-F07-001` AC-2
/// makes Review change no result, and PRD-0001 §9.4 makes it a condition a
/// `Valid` result depends on — so it has to be recorded somewhere.
model AffiliateDestinationReview {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  destinationId String               @map("destination_id") @db.Uuid
  reviewedBy    String               @map("reviewed_by") @db.Uuid
  note          String?              @db.VarChar(1000)
  reviewedAt    DateTime             @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  destination   AffiliateDestination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  reviewer      UserAccount          @relation("AffiliateReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([destinationId, reviewedAt])
  @@map("affiliate_destination_review")
}

model OfferingPublication {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offeringId         String            @map("offering_id") @db.Uuid
  status             PublicationStatus @default(PENDING)
  eligibilityVersion Int               @map("eligibility_version")
  reasonCode         String?           @map("reason_code") @db.VarChar(100)
  evaluatedAt        DateTime          @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  offering           Offering          @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  @@unique([offeringId, eligibilityVersion])
  @@index([status, evaluatedAt])
  @@map("offering_publication")
}

model OfferingSearchProjection {
  offeringId         String   @id @map("offering_id") @db.Uuid
  businessId         String   @map("business_id") @db.Uuid
  domainId           String   @map("domain_id") @db.Uuid
  categoryId         String   @map("category_id") @db.Uuid
  title              String   @db.VarChar(240)
  summary            String?
  businessName       String   @map("business_name") @db.VarChar(200)
  /// The active Category path display names, so a person can recognise an
  /// Offering by where it sits (`US-DSC-F02-001` AC-3).
  categoryPath       String   @map("category_path")
  /// Attribute display values — the label a person reads, not the identifier
  /// `filterValues` holds.
  attributeText      String   @map("attribute_text")
  /// The four searchable fields concatenated. Membership is decided here; which
  /// field matched is decided from the fields themselves.
  searchableText     String   @map("searchable_text")
  filterValues       Json     @map("filter_values")
  publishedAt        DateTime @map("published_at") @db.Timestamptz(6)
  eligibilityVersion Int      @map("eligibility_version")
  projectedAt        DateTime @default(now()) @map("projected_at") @db.Timestamptz(6)
  offering           Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([domainId, categoryId, publishedAt])
  // Declared so the datamodel matches the trigram index created by
  // `20260725000100_initial_platform`. Prisma can see this index, so leaving it
  // undeclared reads as drift. The sibling full-text and partial indexes in that
  // migration are expression-based and remain outside what Prisma models.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "offering_search_projection_title_trgm_idx", type: Gin)
  @@map("offering_search_projection")
}

model AuditRecord {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId         String?  @map("actor_user_id") @db.Uuid
  effectiveBusinessId String?  @map("effective_business_id") @db.Uuid
  action              String   @db.VarChar(120)
  targetType          String   @map("target_type") @db.VarChar(100)
  targetId            String?  @map("target_id") @db.Uuid
  result              String   @db.VarChar(40)
  reason              String?
  correlationId       String   @map("correlation_id") @db.Uuid
  safeMetadata        Json?    @map("safe_metadata")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_record")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(160)
  payload       Json
  /// The request that queued this event (§12.3). Nullable because rows written
  /// before `20260819000100_outbox_correlation` have no identifier to supply,
  /// and because delivery has never depended on one.
  correlationId String?   @map("correlation_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@map("outbox_event")
}
