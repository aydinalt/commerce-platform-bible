NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce
LOG_LEVEL=info

# Accepts the x-test-user-id / x-test-session-id / x-correlation-id principal
# headers used by the first vertical slice until real authentication lands.
# Every authenticated route answers 401 while this is false. The adapter
# refuses to start at all when NODE_ENV=production and this is true.
ENABLE_TEST_PRINCIPAL=false
